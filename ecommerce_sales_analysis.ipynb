        "        Quantity=(\"Quantity\", \"sum\"),\n",
        "        GrossAmount=(\"TotalAmount\", \"sum\")\n",
        "    )\n",
        "    .set_index(\"PriceSegment\")\n",
        "    .reindex(price_labels)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))\n",

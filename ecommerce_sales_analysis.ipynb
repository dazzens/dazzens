      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oy9oTaulIc4B",
        "outputId": "d08a3de6-08ae-41c9-c3b6-3c0231f9be7d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Количество отрицательных записей без префикса C: 0\n"
          ]
        }
      ],
      "source": [
        "# Поиск отрицательных значений без префикса \"C\"\n",
        "\n",
        "negative_without_c = df[(df[\"Quantity\"] < 0) &\n",
        "        (df[\"TransactionNo\"]\n",
        "        .astype(\"string\")\n",
        "        .str.startswith(\"C\", na=False) == False)]\n",
        "\n",
        "print(\"Количество отрицательных записей без префикса C:\",\n",

      "source": [
        "# Поиск неявных дубликатов\n",
        "\n",
        "implicit_duplicates = (\n",
        "    df.groupby(['TransactionNo', 'ProductNo'])\n",
        "      .size()\n",
        "      .reset_index(name='count')\n",
        "      .query('count > 1')\n",
        ")\n",
        "\n",
        "display(implicit_duplicates.head(10))\n",
        "\n",
        "print(f'Найдено комбинаций с повторяющимися товарами: {len(implicit_duplicates)}')\n",
        "\n"
      ]
